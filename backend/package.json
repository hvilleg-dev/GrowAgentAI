{
  "name": "growagentai-backend",
  "version": "2.0.0",
  "description": "GrowAgentAI Coaching Platform Backend - Multi-Provider LLM with GROW Framework",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node -P tsconfig.dev.json src/app.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "typeorm migration:run -d dist/database/db.js",
    "migrate:revert": "typeorm migration:revert -d dist/database/db.js",
    "seed": "node dist/database/seeds.js",
    "seed:kb": "ts-node -P tsconfig.json -r tsconfig-paths/register src/scripts/seedKnowledgeBase.ts"
  },
  "keywords": [
    "coaching",
    "ai",
    "grow-framework",
    "claude",
    "openai",
    "multi-provider"
  ],
  "author": "GrowAgentAI Team",
  "license": "GNU AGPLv3",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.1",
    "@sentry/node": "^7.77.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.28.0",
    "pg": "^8.11.3",
    "pgvector": "^0.1.6",
    "redis": "^4.6.11",
    "typeorm": "^0.3.17",
    "uuid": "^11.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
