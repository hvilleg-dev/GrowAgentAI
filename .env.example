# === ANTHROPIC API ===
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === OPENAI API (Optional - for embeddings) ===
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === DATABASE ===
# PostgreSQL (recommended)
DATABASE_URL=postgresql://growagentai_user:secure_password@database:5432/growagentai

# OR Oracle Database (uncomment to use)
# DATABASE_URL=oracle://username:password@localhost:1521/XE

# OR MySQL (uncomment to use)
# DATABASE_URL=mysql://user:password@database:3306/growagentai

# Database credentials for Docker setup
DB_USER=growagentai_user
DB_PASSWORD=secure_password_change_this
DB_ROOT_PASSWORD=root_password_change_this
DB_DATABASE=growagentai

# === APPLICATION ===
NODE_ENV=development
# Options: development, staging, production

PORT=3000
API_PORT=3001

# Application name
APP_NAME=GrowAgentAI
APP_DESCRIPTION=AI-powered coaching platform with GROW methodology

# === JWT & SECURITY ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRY=1h
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32_characters
JWT_REFRESH_EXPIRY=7d

# === REDIS (Optional - for caching) ===
REDIS_URL=redis://redis:6379/0

# === EMAIL (Optional - for sending emails) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@growagentai.com
SMTP_TLS=true

# === FRONTEND ===
# URL to access frontend
FRONTEND_URL=http://localhost:3000
# URL for frontend to access API
VITE_API_URL=http://localhost:3001

# === FEATURES ===
# Enable/disable features
ENABLE_OAUTH=true
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true
ENABLE_2FA=false
ENABLE_VIDEO_COACHING=false

# === OAUTH (Optional) ===
# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# === CORS ===
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# === MONITORING & LOGGING ===
# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=development

# DataDog (APM & monitoring)
DATADOG_API_KEY=your_datadog_api_key
DATADOG_SITE=datadoghq.com

# Logging level
LOG_LEVEL=info
# Options: debug, info, warn, error

# === AWS (Optional - for S3 storage) ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=growagentai-bucket

# === GOOGLE CLOUD (Optional) ===
GCP_PROJECT_ID=your_project_id
GCP_BUCKET_NAME=growagentai-bucket

# === STRIPE (Optional - for payments) ===
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# === LANGUAGES ===
# Default language for new users
DEFAULT_LANGUAGE=en
# Options: en, es, fr, de, pt, zh, ja

# === ANALYTICS ===
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Segment (product analytics)
SEGMENT_WRITE_KEY=your_write_key

# === FEATURES FLAGS ===
# Beta features (true/false)
BETA_VIDEO_COACHING=false
BETA_TEAM_FEATURES=false
BETA_MARKETPLACE=false

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5

# === SECURITY ===
# Comma-separated list of allowed domains for CORS
TRUSTED_DOMAINS=growagentai.com,www.growagentai.com

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# === SESSION ===
SESSION_SECRET=your_session_secret_here
SESSION_EXPIRY=86400

# === BACKUP ===
# Enable automatic backups
ENABLE_BACKUPS=true
# Backup directory
BACKUP_DIR=/backups
# Backup retention in days
BACKUP_RETENTION_DAYS=30

# === DOCKER ===
# Docker Compose environment
COMPOSE_PROJECT_NAME=growagentai
COMPOSE_FILE=docker-compose.yml

# === DEVELOPMENT ===
# Enable request logging
DEBUG_REQUESTS=false

# Enable query logging
DEBUG_QUERIES=false

# Mock external APIs
MOCK_APIS=false

# === PRODUCTION ===
# (Only set in production .env files)
PROD_DATABASE_HOST=prod-database.example.com
PROD_DATABASE_PORT=5432
PROD_REDIS_URL=redis://prod-redis:6379/0
PROD_FRONTEND_URL=https://growagentai.com
PROD_API_URL=https://api.growagentai.com
