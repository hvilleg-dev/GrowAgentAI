{
  "name": "growagentai-desktop",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "GrowAgentAI Team",
  "description": "AI Coaching Platform - Desktop Edition",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "cd ../web && npm run dev",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "cd ../web && npm run build",
    "build:electron": "tsc",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "electron-is-dev": "^3.0.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.growagentai.app",
    "productName": "GrowAgentAI",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "publish": {
      "provider": "github",
      "owner": "hvilleg-dev",
      "repo": "GrowAgentAI"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
