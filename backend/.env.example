# Backend Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/growagentai

# === API KEYS ===
# OpenAI - for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-proj-...

# Anthropic - for coaching model (claude-opus-5-5)
ANTHROPIC_API_KEY=sk-ant-...

# === GITHUB OAUTH ===
# Get these from GitHub Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=Iv1.xxxxx
GITHUB_CLIENT_SECRET=xxxxxxx

# Must match exactly in GitHub app settings
# Local: http://localhost:3001/auth/github/callback
# Production: https://api.growagentai.com/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# === FRONTEND ===
# For redirects and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# === DEPLOYMENT ===
# production | development | test
NODE_ENV=development

# API Port
PORT=3001

# Logging: error | warn | info | debug
LOG_LEVEL=info

# === OPTIONAL ===
# Sentry error tracking
SENTRY_DSN=https://key@sentry.io/project

# === DEVELOPMENT ONLY ===
# For local testing with mock embeddings (if OPENAI_API_KEY not set)
# MOCK_EMBEDDINGS=true
