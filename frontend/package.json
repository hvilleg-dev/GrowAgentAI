{
  "name": "growagentai-frontend",
  "version": "2.0.0",
  "description": "GrowAgentAI Frontend - Multi-platform UI (Web, Desktop, Mobile)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:desktop": "pnpm --filter desktop run dev",
    "dev:mobile": "pnpm --filter mobile run dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter web run build",
    "build:desktop": "pnpm --filter desktop run build",
    "build:mobile": "pnpm --filter mobile run build",
    "preview": "pnpm --filter web run preview",
    "test": "pnpm -r run test",
    "test:web": "pnpm --filter web run test",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "type-check": "pnpm -r run type-check",
    "install-all": "pnpm install && pnpm -r install"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "pnpm": "^8.12.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
